{
  "name": "accuratum",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [
    8888
  ],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "CLAUDE_CONFIG_DIR": "/workspaces/accuratum/.claude-data"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "anthropic.claude-code",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/accuratum/.venv/bin/python"
      }
    }
  }
}